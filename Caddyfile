# 1. Основной сайт (Next.js)

beraum.com, www.beraum.com { # Caddy сам обернет это в HTTPS и перенаправит трафик во внутренний контейнер web на порт 3000
reverse_proxy web:3000
}

# 2. Публичный доступ к фото товаров (API MinIO)

s3.beraum.com {
reverse_proxy storage:9000
}

# 3. Консоль администратора MinIO (Web UI)

admin-s3.beraum.com {
reverse_proxy storage:9001
}

# 4. Блок редиректов (кириллица, .ru и .net)

xn--80ac3a3am.xn--p1ai, www.xn--80ac3a3am.xn--p1ai, beraum.ru, www.beraum.ru, beraum.net, www.beraum.net {
    redir https://beraum.com{uri} 301
}